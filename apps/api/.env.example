# Go 서버는 프로세스 환경 변수만 읽으며 .env 파일을 자동으로 로드하지 않는다.
# 로컬에서 값을 바꾸려면 환경 변수를 export하거나 실행할 때 직접 지정한다.
# 예: API_PORT=9000 pnpm dev:api

# API 서버 바인딩 주소.
# 같은 네트워크의 모바일 기기에서 접근해야 한다면 0.0.0.0을 사용한다.
API_HOST=127.0.0.1
API_PORT=8080
API_ENV=development

# Postgres 접속 주소. 기본값이 없으며 비어 있으면 서버가 기동하지 않는다.
DATABASE_URL=

# 현재는 브라우저에서 API를 직접 호출하지 않으므로 CORS 설정을 두지 않는다.
# 추후 브라우저에서 직접 호출하게 되면 허용 Origin을 환경 변수로 추가한다.
# API_ALLOWED_ORIGIN=http://localhost:3000
