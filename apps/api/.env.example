# The Go server reads process environment variables only. It does not load a
# .env file, so copying this to .env does nothing on its own. Export the values
# or set them inline:
#   API_PORT=9000 pnpm dev:api

# Bind address. Use 0.0.0.0 to accept connections from a phone on the same LAN.
API_HOST=127.0.0.1
API_PORT=8080
API_ENV=development

# Once the browser calls the API directly, cross-origin requests need an allowed
# origin. The server does not read this yet; it is here to fix the name in advance.
# API_ALLOWED_ORIGIN=http://localhost:3000
