# Go 서버는 프로세스 환경 변수만 읽으며 .env 파일을 자동으로 로드하지 않는다.
# 로컬에서 값을 바꾸려면 환경 변수를 export하거나 실행할 때 직접 지정한다.
# 예: API_PORT=9000 pnpm dev:api

# API 서버 바인딩 주소.
# 같은 네트워크의 모바일 기기에서 접근해야 한다면 0.0.0.0을 사용한다.
API_HOST=127.0.0.1
API_PORT=8080
API_ENV=development

# Postgres 접속 주소. 기본값이 없으며 비어 있으면 서버가 기동하지 않는다.
DATABASE_URL=

# 인증 기반. 전부 비우면 인증이 비활성(/v1/auth/* 503)이고, 일부만 채우면 서버가 기동하지 않는다.
# production은 AUTH_PUBLIC_BASE_URL · AUTH_WEB_ORIGIN에 https만 허용한다.
AUTH_PUBLIC_BASE_URL=
# scheme://host[:port] 형식, 경로 없음
AUTH_WEB_ORIGIN=
AUTH_MOBILE_REDIRECT_URI=
# base64로 인코딩한 32바이트 키. 값은 Secret Manager에만 두고 저장소에 커밋하지 않는다.
AUTH_ENCRYPTION_KEY=
# 암호문과 함께 저장되는 키 식별자. 키를 바꿀 때 새 값을 쓴다.
AUTH_ENCRYPTION_KEY_ID=
# 가입 시 profile에 기록할 이용약관 · 개인정보처리방침 버전
AUTH_TERMS_VERSION=
AUTH_PRIVACY_VERSION=

# 현재는 브라우저에서 API를 직접 호출하지 않으므로 CORS 설정을 두지 않는다.
# 추후 브라우저에서 직접 호출하게 되면 허용 Origin을 환경 변수로 추가한다.
# API_ALLOWED_ORIGIN=http://localhost:3000
