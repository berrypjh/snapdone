# The Go server reads process environment variables only. It does not load a
# .env file, so copying this to .env does nothing on its own. Export the values
# or set them inline:
#   API_PORT=9000 pnpm dev:api

# Bind address. Use 0.0.0.0 to accept connections from a phone on the same LAN.
API_HOST=127.0.0.1
API_PORT=8080
API_ENV=development

# No CORS setting exists because nothing sends a cross-origin request yet: the
# web app calls this API from its server, and the mobile app is not a browser.
# The day a browser calls this API directly, add an allowed origin here and read
# it in the server. See docs/architecture/data-access.md.
# API_ALLOWED_ORIGIN=http://localhost:3000
