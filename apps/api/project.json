{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api",
  "tags": ["type:app"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "options": {
        "cwd": "apps/api",
        "command": "go run ./cmd/server"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/api",
        "command": "go run ./cmd/migrate"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "options": {
        "cwd": "apps/api",
        "command": "go build -o ../../dist/apps/api/api ./cmd/server"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"],
      "options": {
        "cwd": "apps/api",
        "command": "go test ./..."
      }
    },
    "vet": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"],
      "options": {
        "cwd": "apps/api",
        "command": "go vet ./..."
      }
    },
    "swagger": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/api",
        "command": "go tool swag init -q -g cmd/server/main.go --parseInternal -o docs/swagger --packageName swagger"
      }
    },
    "swagger-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"],
      "options": {
        "cwd": "apps/api",
        "command": "tmp=$(mktemp -d \"${TMPDIR:-/tmp}/swagger.XXXXXX\") && trap 'rm -rf \"$tmp\"' EXIT && go tool swag init -q -g cmd/server/main.go --parseInternal -o \"$tmp\" --packageName swagger && { diff -r docs/swagger \"$tmp\" || { echo 'docs/swagger is stale; run nx run api:swagger'; exit 1; }; }"
      }
    },
    "fmt": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"],
      "options": {
        "cwd": "apps/api",
        "command": "unformatted=$(gofmt -l .); if [ -n \"$unformatted\" ]; then echo 'gofmt required for:'; echo \"$unformatted\"; exit 1; fi"
      }
    }
  }
}
