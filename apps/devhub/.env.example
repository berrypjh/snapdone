# 파일 경로 옆의 "에디터에서 열기"가 어느 에디터를 여는가.
# 개발 서버(pnpm dev:devhub)에서만 쓰이며, 빌드된 페이지에는 이 링크가 아예 없다.
#
# 입력 가능 이름: antigravity · cursor · vscode · windsurf · zed · idea · webstorm
# 목록에 없으면 URL 형식을 직접 적는다. {path}에 이 컴퓨터의 절대 경로가 들어간다. DEVHUB_EDITOR=mate://open?url=file://{path}
# 모르는 값이면 기본값(vscode)으로 돌아간다.
DEVHUB_EDITOR=antigravity

# /evals "정식 run 명령 만들기"의 모델 목록. 새로고침마다 서버가 공급자의 모델 목록 API를 불러 최신 모델을 보인다.
# key는 요청 헤더에만 쓰고 화면 · 브라우저 · 파일에 싣지 않는다. 비워 두면 그 회사 모델 없이 이유만 보이고 모델은 직접 적는다.
# 실제 값은 복사한 로컬 파일에만 넣고, 이 예시 파일에는 넣지 않는다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 화면 머리의 커밋 · branch. 비워 두면 git에서 읽는다(git이 없는 빌드 환경에서만 넣는다).
# DEVHUB_COMMIT_SHA=
# DEVHUB_BRANCH=
