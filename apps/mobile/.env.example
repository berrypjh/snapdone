# Expo reads .env from this directory. Copy this file to .env.
#
# EXPO_PUBLIC_ values are inlined into the app bundle and are readable by anyone
# who has the app. Never put a secret here. The mobile app has no server side,
# so anything it needs is public by definition.
#
# localhost works on a simulator or emulator only. On a physical device it points
# at the device itself, not your machine. Use your machine's LAN address instead:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8080
# See docs/development/local-development.md.

EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
