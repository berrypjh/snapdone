# 이 파일을 .env로 복사해서 사용한다.
#
# EXPO_PUBLIC_ 환경변수는 앱 번들에 포함되므로
# API Key, Token 등 민감한 값은 절대 저장하지 않는다.
#
# localhost는 시뮬레이터/에뮬레이터 환경에서만 사용할 수 있다.
# 실제 디바이스에서는 개발 머신의 LAN IP를 사용한다.
# 예: EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8080
#
# 자세한 내용: docs/development/local-development.md

EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
