# 이 파일을 .env.local로 복사해서 사용한다.
#
# API_BASE_URL은 Server Component에서만 사용하므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# 서버에서 Go API를 호출하기 때문에 브라우저 번들에 포함되지 않으며 CORS 설정도 필요하지 않다.
#
# 클라이언트에서 직접 API를 호출해야 하는 경우에는 NEXT_PUBLIC_ 환경변수와
# Go 서버의 CORS 허용 Origin 설정이 필요하다.
#
# NEXT_PUBLIC_ 환경변수는 브라우저에 노출되므로 민감한 값은 저장하지 않는다.
# 자세한 내용: docs/architecture/data-access.md

API_BASE_URL=http://localhost:8080
