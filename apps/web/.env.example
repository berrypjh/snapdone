# Next.js reads .env.local from this directory. Copy this file to .env.local.
#
# API_BASE_URL has no NEXT_PUBLIC_ prefix on purpose. The web app calls the Go
# API from the server (Server Components), so the value never reaches the
# browser bundle and the API needs no CORS configuration.
#
# If a browser-side call is ever added, that value needs a NEXT_PUBLIC_ prefix
# and the Go server needs an allowed origin. See docs/architecture/data-access.md.
#
# NEXT_PUBLIC_ values are inlined into the browser bundle. Never put a secret
# behind that prefix.

API_BASE_URL=http://localhost:8080
