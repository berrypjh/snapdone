# API_BASE_URL은 Server Component에서만 사용하므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# 서버에서 Go API를 호출하기 때문에 브라우저 번들에 포함되지 않으며 CORS 설정도 필요하지 않다.
#
# 클라이언트에서 직접 API를 호출해야 하는 경우에는 NEXT_PUBLIC_ 환경변수와
# Go 서버의 CORS 허용 Origin 설정이 필요하다.
#
# NEXT_PUBLIC_ 환경변수는 브라우저에 노출되므로 민감한 값은 저장하지 않는다.

API_BASE_URL=http://localhost:8080

# 이 web이 서비스되는 origin(scheme://host[:port], 경로 없음). Go의 AUTH_WEB_ORIGIN과 같은 값이다.
# 로그인 · 로그아웃 요청의 Origin 헤더를 이 값과 비교한다. production은 https만 허용한다.
WEB_ORIGIN=http://localhost:3000

# 이용약관 · 개인정보처리방침 문서(https). 둘 다 있어야 링크가 보인다.
# production에서 비어 있으면 로그인(가입)이 비활성이다.
TERMS_URL=
PRIVACY_URL=

# 브라우저 · 서버 오류를 보낼 Sentry DSN. 빌드 때 번들에 들어가는 공개 값이다. 비우면 Sentry를 켜지 않는다.
# 배포 이미지는 deploy.sh가 Secret Manager의 WEB_SENTRY_DSN으로 넣는다.
NEXT_PUBLIC_SENTRY_DSN=
