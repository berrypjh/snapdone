{
  "name": "@snapdone/web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "web",
    "projectType": "application",
    "tags": [
      "type:app"
    ],
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/**/*.ts",
          "{projectRoot}/**/*.tsx",
          "{projectRoot}/tsconfig.json",
          "{workspaceRoot}/tsconfig.base.json"
        ],
        "options": {
          "cwd": "apps/web",
          "command": "tsc --noEmit -p tsconfig.json"
        }
      }
    }
  },
  "dependencies": {
    "@berrypjh/react-ui": "^1.2.0",
    "@sentry/nextjs": "^11.6.0",
    "@snapdone/auth-contracts": "workspace:*",
    "@snapdone/onboarding": "workspace:*",
    "@snapdone/processing": "workspace:*",
    "@snapdone/webview-bridge": "workspace:*",
    "lucide-react": "^1.52.0",
    "next": "~16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
