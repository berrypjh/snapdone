{
  "name": "@snapdone/web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "web",
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/**/*.ts",
          "{projectRoot}/**/*.tsx",
          "{projectRoot}/tsconfig.json",
          "{workspaceRoot}/tsconfig.base.json"
        ],
        "options": {
          "cwd": "apps/web",
          "command": "tsc --noEmit -p tsconfig.json"
        }
      }
    }
  },
  "dependencies": {
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
