{
  "name": "@snapdone/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many -t dev",
    "dev:web": "nx dev web",
    "dev:mobile": "nx start mobile",
    "dev:api": "nx dev api",
    "dev:devhub": "nx dev devhub",
    "migrate": "nx run api:migrate",
    "swagger": "nx run api:swagger",
    "swagger:check": "nx run api:swagger-check",
    "eval": "nx run api:eval",
    "eval:check": "nx run api:eval-check",
    "eval:lab": "uv --directory tools/evals/lab run jupyter lab notebooks",
    "eval:lab:setup": "uv --directory tools/evals/lab sync",
    "eval:lab:test": "uv --directory tools/evals/lab run pytest",
    "lint": "nx run-many -t lint,vet,fmt && eslint eslint.config.mjs tools/scripts .claude/hooks",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:hooks": "node --test tools/scripts/*.test.mjs",
    "harness:sync": "node tools/scripts/harness.mjs sync",
    "harness:check": "node tools/scripts/harness.mjs check",
    "devhub:check": "nx run devhub:devhub-check",
    "e2e": "nx run-many -t e2e",
    "build": "nx run-many -t build --exclude=mobile",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:hooks && pnpm build",
    "health": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/scripts/check-api-health.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}": [
      "eslint --flag v10_config_lookup_from_file --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yaml,yml}": [
      "prettier --write"
    ],
    "*.go": [
      "gofmt -w"
    ]
  },
  "prettier": "@berrypjh/prettier-config",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@babel/runtime": "~7.27.6",
    "@berrypjh/commitlint-config": "^1.2.0",
    "@berrypjh/eslint-config": "1.2.0",
    "@berrypjh/prettier-config": "^1.2.0",
    "@berrypjh/tsconfig": "^1.2.0",
    "@commitlint/cli": "^20.5.3",
    "@eslint/js": "^9.8.0",
    "@expo/cli": "~56.1.14",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/expo": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/next": "23.1.1",
    "@nx/playwright": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@playwright/test": "^1.37.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "babel-preset-expo": "~56.0.14",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nx": "23.1.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  },
  "dependencies": {
    "@berrypjh/react-native-ui": "1.2.0",
    "@expo/metro": "~56.0.0",
    "@expo/metro-runtime": "~56.0.14",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.1",
    "expo": "~56.0.0",
    "expo-crypto": "~56.0.4",
    "expo-image-picker": "~56.0.23",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.6",
    "next": "~16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-svg-transformer": "~1.5.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1"
  }
}
